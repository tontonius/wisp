{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "editor/**/*.ts", "demo/**/*.ts", "tests/**/*.ts", "*.config.ts", "vite-env.d.ts"],
  "exclude": ["node_modules", "dist", "dist-editor"]
}
