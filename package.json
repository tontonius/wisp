{
  "name": "@tontonius/wisp",
  "version": "0.2.0",
  "description": "Game-feel effects for Three.js, starting with a high-performance particle system.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webgpu": {
      "types": "./dist/webgpu.d.ts",
      "import": "./dist/webgpu.js"
    },
    "./starter": {
      "types": "./dist/starter/index.d.ts",
      "import": "./dist/starter.js"
    },
    "./starter/textures": {
      "types": "./dist/starter/textures/index.d.ts",
      "import": "./dist/starter/textures.js"
    },
    "./starter/effects": {
      "types": "./dist/starter/effects/index.d.ts",
      "import": "./dist/starter/effects.js"
    },
    "./starter/effects/explosion": {
      "types": "./dist/starter/effects/explosion.d.ts",
      "import": "./dist/starter/effects/explosion.js"
    },
    "./starter/effects/muzzle-flash": {
      "types": "./dist/starter/effects/muzzle-flash.d.ts",
      "import": "./dist/starter/effects/muzzle-flash.js"
    },
    "./starter/effects/smoke-puff": {
      "types": "./dist/starter/effects/smoke-puff.d.ts",
      "import": "./dist/starter/effects/smoke-puff.js"
    },
    "./starter/effects/hit-sparks": {
      "types": "./dist/starter/effects/hit-sparks.d.ts",
      "import": "./dist/starter/effects/hit-sparks.js"
    },
    "./starter/effects/magic-burst": {
      "types": "./dist/starter/effects/magic-burst.d.ts",
      "import": "./dist/starter/effects/magic-burst.js"
    },
    "./starter/effects/run-smoke": {
      "types": "./dist/starter/effects/run-smoke.d.ts",
      "import": "./dist/starter/effects/run-smoke.js"
    },
    "./starter/effects/jump-smoke-ring": {
      "types": "./dist/starter/effects/jump-smoke-ring.d.ts",
      "import": "./dist/starter/effects/jump-smoke-ring.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:editor": "vite --host 0.0.0.0 --open /editor/",
    "build": "npm run build:lib",
    "build:lib": "vite build --config vite.lib.config.ts && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "build:editor": "vite build --outDir dist-editor",
    "build:pages": "GITHUB_PAGES=true vite build",
    "prepublishOnly": "npm run build:lib && npm pack --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@vitest/ui": "^3.0.0",
    "@tweakpane/core": "^2.0.5",
    "@tweakpane/plugin-essentials": "^0.2.1",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-basic-ssl": "latest",
    "happy-dom": "^15.11.7",
    "tweakpane": "^4.0.5",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^3.0.0"
  }
}
